{
  "manifest_version": 3,
  "name": "Google Flow 号池一键授权助手",
  "version": "1.1.0",
  "description": "在已登录的 Google 浏览器中一键授权凭据并导入本地号池，自动识别账户邮箱",
  "permissions": [
    "cookies",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.google.com/*",
    "*://127.0.0.1:8765/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Google Flow 一键授权"
  }
}